{
  "name": "@sanity/pandacss-tsdown-plugin",
  "version": "0.2.0",
  "description": "tsdown plugin for Panda CSS that extracts the generated CSS into a lightningcss-optimized file, complementary to @pandacss/vite",
  "keywords": [
    "sanity-io",
    "sanity",
    "pandacss",
    "panda",
    "tsdown",
    "rolldown",
    "vite",
    "css",
    "lightningcss",
    "plugin"
  ],
  "homepage": "https://github.com/sanity-io/pkg-utils/tree/main/packages/@sanity/pandacss-tsdown-plugin#readme",
  "bugs": {
    "url": "https://github.com/sanity-io/pkg-utils/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/sanity-io/pkg-utils.git",
    "directory": "packages/@sanity/pandacss-tsdown-plugin"
  },
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./vite": "./src/vite.ts",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm build",
    "prepare": "panda codegen --cwd test/fixtures/basic && panda codegen --cwd test/fixtures/dynamic && panda codegen --cwd test/fixtures/codegen && panda codegen --cwd test/fixtures/recipes && panda codegen --cwd test/fixtures/cascade-layers && panda codegen --cwd test/fixtures/vite",
    "test": "vitest run",
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@pandacss/compiler": "catalog:",
    "@pandacss/transformer": "catalog:",
    "lightningcss": "catalog:",
    "postcss": "catalog:"
  },
  "devDependencies": {
    "@pandacss/dev": "catalog:",
    "@pandacss/vite": "catalog:",
    "@sanity/tsconfig": "workspace:^",
    "@sanity/tsdown-config": "workspace:^",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "catalog:",
    "publint": "catalog:",
    "rolldown": "~1.2.14",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.3.4",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@pandacss/dev": "*",
    "tsdown": "^0.23.0",
    "vite": "*"
  },
  "peerDependenciesMeta": {
    "@pandacss/dev": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./vite": "./dist/vite.mjs",
      "./package.json": "./package.json"
    }
  }
}
