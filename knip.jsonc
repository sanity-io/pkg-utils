{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "treatConfigHintsAsErrors": true,
  "ignoreWorkspaces": [
    "playground/*",
    "css-playground/*",
    "packages/@sanity/tsdown-config/test/fixtures/**",
  ],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true,
  },
  "rules": {
    // dev workspaces are ignored, so their catalog entries appear unused
    "catalog": "warn",
  },
  "workspaces": {
    ".": {
      "entry": ["*.{ts,mts,mjs}"],
      "project": ["*.{ts,mts,mjs}"],
      "ignoreDependencies": [
        "@sanity/pkg-utils",
        "@sanity/tsdown-config",
        "husky",
        "rimraf",
        "tsdown",
      ],
    },
    "packages/@sanity/pkg-utils": {
      "entry": ["package.config.ts", "scripts/*.ts", "src/cli/index.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"],
      "ignoreBinaries": ["sanity-tsdoc"],
    },
    "packages/@sanity/pandacss-tsdown-plugin": {
      // The fixtures are rolldown build inputs referenced by path, not imported from the tests,
      // their Panda configs are loaded by Panda's node driver, and the Vitest config of the
      // `vite` fixture is run by a Vitest the tests start
      "entry": [
        "test/fixtures/*/src/*.ts",
        "test/fixtures/*/panda.config.ts",
        "test/fixtures/*/vitest.config.ts",
      ],
      "project": ["src/**/*.ts", "test/**/*.ts"],
    },
    "packages/@sanity/parse-package-json": {
      "project": ["src/**/*.ts", "test/**/*.ts"],
    },
    "packages/@sanity/tsdown-config": {
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": [
        // Used in test fixtures, not imported in package source
        "@sanity/pkg-utils",
      ],
    },
    "packages/@sanity/oxfmt-config": {
      "entry": ["test/**/*.ts"],
      "project": ["test/**/*.ts"],
    },
    "packages/@sanity/oxlint-config": {
      "entry": ["test/**/*.ts"],
      "project": ["test/**/*.ts"],
    },
    "packages/@sanity/tsconfig": {},
  },
}
