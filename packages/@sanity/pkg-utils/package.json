{
  "name": "@sanity/pkg-utils",
  "version": "12.3.2",
  "description": "Simple utilities for modern npm packages.",
  "keywords": [
    "sanity-io",
    "sanity",
    "npm",
    "package",
    "utilities",
    "build",
    "bundling"
  ],
  "homepage": "https://github.com/sanity-io/pkg-utils#readme",
  "bugs": {
    "url": "https://github.com/sanity-io/pkg-utils/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/sanity-io/pkg-utils.git",
    "directory": "packages/@sanity/pkg-utils"
  },
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/node/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pkg": "./bin/pkg-utils.js",
    "pkg-utils": "./bin/pkg-utils.js"
  },
  "files": [
    "bin",
    "dist",
    "tsconfig",
    "MIGRATE.md",
    "!dist/stats.html"
  ],
  "scripts": {
    "build": "run-s clean build:pkg check:pkg",
    "build:pkg": "tsx scripts/build.ts",
    "check:pkg": "tsx scripts/check.ts",
    "clean": "rimraf dist test/env/__tmp__",
    "extract": "sanity-tsdoc etl --outDir etc/api/@sanity/pkg-utils --tsconfig tsconfig.dist.json",
    "prepublishOnly": "pnpm run build",
    "pretest": "pnpm run clean && pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --build",
    "watch": "tsx scripts/watch.ts"
  },
  "browserslist": "extends @sanity/browserslist-config",
  "dependencies": {
    "@sanity/browserslist-config": "^1.0.5",
    "@sanity/parse-package-json": "workspace:^",
    "@sanity/tsdown-config": "workspace:^",
    "@typescript/typescript6": "^6.0.2",
    "browserslist": "^4.28.8",
    "browserslist-to-esbuild": "2.1.1",
    "cac": "^7.0.0",
    "chalk": "^6.0.0",
    "chokidar": "^5.0.0",
    "empathic": "^2.0.1",
    "find-config": "^1.0.0",
    "get-latest-version": "^6.0.1",
    "globby": "^16.2.4",
    "mkdirp": "^3.0.1",
    "outdent": "^0.8.0",
    "prettier": "^3.9.6",
    "pretty-bytes": "^7.1.1",
    "prompts": "^2.4.2",
    "publint": "^0.3.24",
    "rxjs": "^7.8.2",
    "treeify": "^1.1.0",
    "tsdown": "catalog:",
    "tsx": "^4.23.12",
    "zod": "^4.4.3",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@sanity/tsconfig": "workspace:^",
    "@types/find-config": "^1.0.4",
    "@types/node": "catalog:",
    "@types/parse-github-url": "^1.0.3",
    "@types/prompts": "^2.4.9",
    "@types/treeify": "^1.0.3",
    "babel-plugin-react-compiler": "1.0.0",
    "nanoexec": "^1.1.0",
    "oxc-transform-react": "0.145.0",
    "parse-github-url": "^1.0.4",
    "rimraf": "^6.1.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@tsdown/css": "*",
    "babel-plugin-react-compiler": "*",
    "oxc-transform-react": "*",
    "typescript": "6.x || 7.x"
  },
  "peerDependenciesMeta": {
    "@tsdown/css": {
      "optional": true
    },
    "babel-plugin-react-compiler": {
      "optional": true
    },
    "oxc-transform-react": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  }
}
