{
  "name": "sanity-plugin-with-vanilla-extract",
  "version": "0.0.0-development",
  "private": true,
  "license": "MIT",
  "sideEffects": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./bundle.css": {
      "types": "./dist/bundle-css.d.ts",
      "browser": "./dist/bundle.css",
      "style": "./dist/bundle.css",
      "node": "./dist/bundle-css.js",
      "default": "./dist/bundle-css.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pkg build --strict --check --clean",
    "clean": "rimraf dist",
    "dev": "sanity dev",
    "typecheck": "tsc"
  },
  "browserslist": "extends @sanity/browserslist-config",
  "dependencies": {
    "@sanity/ui": "4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vanilla-extract/css": "^1.21.2",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "babel-plugin-react-compiler": "1.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanity": "^6.9.1",
    "styled-components": "^6.5.1",
    "vite": "^8.2.0"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "sanity": "^4 || ^5.0.0 || ^6.0.0"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./bundle.css": {
        "types": "./dist/bundle-css.d.ts",
        "browser": "./dist/bundle.css",
        "style": "./dist/bundle.css",
        "node": "./dist/bundle-css.js",
        "default": "./dist/bundle-css.js"
      },
      "./package.json": "./package.json"
    }
  }
}
