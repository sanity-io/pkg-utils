{
  "name": "@sanity/vanilla-extract-integration",
  "version": "0.1.19",
  "description": "Vendored port of @vanilla-extract/integration onto the rolldown toolchain: yuku-parsed debug IDs and a rolldown child compilation instead of babel and esbuild",
  "keywords": [
    "sanity-io",
    "sanity",
    "vanilla-extract",
    "rolldown",
    "yuku",
    "oxc",
    "css"
  ],
  "homepage": "https://github.com/sanity-io/pkg-utils/tree/main/packages/@sanity/vanilla-extract-integration#readme",
  "bugs": {
    "url": "https://github.com/sanity-io/pkg-utils/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/sanity-io/pkg-utils.git",
    "directory": "packages/@sanity/vanilla-extract-integration"
  },
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "bench": "vitest bench",
    "build": "tsdown",
    "generate:property-groups": "node scripts/generatePropertyGroups.ts",
    "install-browser": "playwright install chromium",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@vanilla-extract/css": "^1.21.2",
    "css-what": "^6.2.2",
    "javascript-stringify": "^2.1.0",
    "media-query-parser": "^2.0.2",
    "modern-ahocorasick": "^1.1.0",
    "rolldown": "~1.2.9",
    "yuku-parser": "^0.10.2"
  },
  "devDependencies": {
    "@sanity/tsconfig": "workspace:^",
    "@sanity/tsdown-config": "workspace:^",
    "@types/node": "catalog:",
    "@vanilla-extract/recipes": "^0.5.7",
    "@vanilla-extract/sprinkles": "^1.7.1",
    "mdn-data": "^2.27.1",
    "playwright": "^1.63.0",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  }
}
